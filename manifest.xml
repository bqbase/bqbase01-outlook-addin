<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
    xsi:type="MailApp">
  <Id>b7e1a5c2-1f3d-4a9e-9c2a-5b6d7e8f9a01</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>BQBase</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="BQBase Email Assistant - v1.0" />
  <Description DefaultValue="Chat with an AI assistant to draft and refine email replies, right inside Outlook." />
  <IconUrl DefaultValue="https://bqbase.github.io/bqbase01-outlook-addin/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://bqbase.github.io/bqbase01-outlook-addin/icon-64.png" />
  <SupportUrl DefaultValue="https://github.com/bqbase/bqbase01-outlook-addin" />
  <AppDomains>
    <AppDomain>https://bqbase.github.io</AppDomain>
    <AppDomain>https://bqbase-openrouter-proxy.bqbase.workers.dev</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>
  <!-- FormSettings/DesktopSettings is legacy (only used by pre 1.3 Outlook
       clients) and is IGNORED at runtime once VersionOverrides is present
       below, but the schema still requires SOME FormSettings block to
       validate at all. Element order (SourceLocation before RequestedHeight)
       and the RequestedHeight requirement itself were both found empirically
       via office-addin-manifest validate during this project's feasibility
       prototype. See addin_prototype/manifest.xml's own comment and
       STATE.md for the full story; not re-derived here. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://bqbase.github.io/bqbase01-outlook-addin/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://bqbase.github.io/bqbase01-outlook-addin/taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="msgComposeOpenPaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://bqbase.github.io/bqbase01-outlook-addin/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://bqbase.github.io/bqbase01-outlook-addin/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://bqbase.github.io/bqbase01-outlook-addin/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://bqbase.github.io/bqbase01-outlook-addin/taskpane.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://bqbase.github.io/bqbase01-outlook-addin/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="BQBase" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="BQBase" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the BQBase Email Assistant - v1.0 task pane" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
